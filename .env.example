# ============================================================
# SmritiSetu Environment Configuration Template (.env.example)
# DO NOT PUT REAL SECRETS IN THIS FILE.
# Copy this file to .env and supply your local development values.
# ============================================================

# Environment: development | staging | production
APP_ENV=development

# Application Identifiers
APP_NAME=SmritiSetu
APP_VERSION=1.0.0

# Backend API Configuration
API_BASE_URL=https://api.smritisetu.gov.in/api/v1
API_TIMEOUT_MS=10000

# Digital India Bhashini Voice Pipeline (Credentials provided by Bhashini portal)
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_PIPELINE_ID=your_bhashini_pipeline_id_here

# JWT Authentication (Backend only)
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRATION=900s
REFRESH_TOKEN_EXPIRATION=30d

# SQLite Local Database
SQLITE_DB_NAME=smriti_setu.db
SQLITE_DB_VERSION=1

# Offline Synchronization
SYNC_INTERVAL_SECONDS=60
SYNC_BATCH_SIZE=25
MAX_SYNC_RETRIES=5
